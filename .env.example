# ============================================================
# Bachelor KI Web Crawler – Konfigurationsvorlage
# Kopieren nach .env und Werte anpassen:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# WICHTIG: .env niemals committen! (steht in .gitignore)
# ============================================================

# --- Datenbankverbindung ------------------------------------
# PostgreSQL über WireGuard VPN (Server-IP: 10.0.0.1)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATENBANKNAME
DATABASE_URL=postgresql://postgres:your-password@10.0.0.1:5432/bachelor_crawler

# SQLite (lokal, kein VPN nötig – nur für Tests):
# DATABASE_URL=sqlite:///./bachelor_crawler.db

# Datenbankpersistierung im Crawler aktivieren:
CRAWLER_DB_ENABLED=true

# --- LLM-Zugang ---------------------------------------------
# OpenAI-kompatibler Endpunkt:
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # Standard OpenAI
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama lokal
# LLM_MODEL=gpt-4o-mini

# LLM-Analyse im Crawler aktivieren:
CRAWLER_LLM_ENABLED=false

# LLM-Parameter (optional):
# CRAWLER_LLM_MAX_TOKENS=512
# CRAWLER_LLM_TEMPERATURE=0.0

# --- Crawler-Verhalten --------------------------------------
# Pause zwischen Requests in Sekunden (Rate-Limiting):
CRAWLER_REQUEST_DELAY=1.0

# Maximale Anzahl gecrawlter Seiten:
CRAWLER_MAX_PAGES=100

# User-Agent:
CRAWLER_USER_AGENT=BachelorCrawler/0.1 (+https://github.com/Cedrics7/Bachelor_KI_Web_Crawler)

# robots.txt respektieren (true/false):
CRAWLER_ROBOTS_RESPECT=true

# DSGVO-PII-Filter aktivieren:
CRAWLER_PRIVACY_FILTER_PII=true

# JavaScript-Rendering via Playwright (true/false):
CRAWLER_JS_RENDERING=false

# RAM-Warnschwelle in MB:
CRAWLER_RAM_WARN_MB=1500

# Log-Verzeichnis:
CRAWLER_LOG_DIR=logs

# --- Playwright / JS-Rendering ------------------------------
# Timeout in Millisekunden:
RENDER_TIMEOUT_MS=10000
