# ============================================================
# Bachelor KI Web Crawler – Konfigurationsvorlage
# Kopieren nach .env und Werte anpassen:
#   cp .env.example .env
# ============================================================

# --- Datenbankverbindung (FastAPI / main.py) -----------------
# SQLite (Standard, kein Server nötig):
DATABASE_URL=sqlite:///./termine.db

# PostgreSQL-Beispiel:
# DATABASE_URL=postgresql://user:password@localhost:5432/bachelor_crawler

# --- LLM-Zugang (crawler_js/llm_client.py) ------------------
# OpenAI-kompatibler Endpunkt:
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional bei lokalem Modell
# LLM_MODEL=gpt-4o-mini                       # Modellname

# --- Crawler-Verhalten --------------------------------------
# Maximale Crawl-Tiefe für den Focused Crawler:
CRAWLER_MAX_DEPTH=2

# Pause zwischen Requests in Sekunden (Rate-Limiting):
CRAWLER_REQUEST_DELAY=1.0

# User-Agent:
CRAWLER_USER_AGENT=BachelorCrawler/0.1 (+https://github.com/Cedrics7/Bachelor_KI_Web_Crawler)

# --- Playwright / JS-Rendering -------------------------------
# Timeout in Millisekunden für render_url.py:
RENDER_TIMEOUT_MS=10000
